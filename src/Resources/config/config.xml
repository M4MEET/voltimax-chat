<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/shopware/platform/master/src/Core/System/SystemConfig/Schema/config.xsd">

    <!-- Card 1: General -->
    <card>
        <title>General</title>
        <title lang="de-DE">Allgemein</title>

        <input-field type="bool">
            <name>pluginEnabled</name>
            <label>Enable chat widget</label>
            <label lang="de-DE">Chat-Widget aktivieren</label>
            <defaultValue>false</defaultValue>
        </input-field>

        <input-field type="single-select">
            <name>widgetPosition</name>
            <label>Widget position</label>
            <label lang="de-DE">Widget-Position</label>
            <options>
                <option>
                    <id>bottom-right</id>
                    <name>Bottom right</name>
                    <name lang="de-DE">Unten rechts</name>
                </option>
                <option>
                    <id>bottom-left</id>
                    <name>Bottom left</name>
                    <name lang="de-DE">Unten links</name>
                </option>
            </options>
            <defaultValue>bottom-right</defaultValue>
        </input-field>

        <component name="sw-entity-single-select">
            <name>salesChannelId</name>
            <label>Sales channel for CMS sync</label>
            <label lang="de-DE">Verkaufskanal für CMS-Synchronisierung</label>
            <entity>sales_channel</entity>
            <helpText>Only CMS pages from this sales channel will be synced to the knowledge base.</helpText>
            <helpText lang="de-DE">Nur CMS-Seiten aus diesem Verkaufskanal werden in die Wissensdatenbank synchronisiert.</helpText>
        </component>
    </card>

    <!-- Card 2: Server B Connection -->
    <card>
        <title>AI Server Connection</title>
        <title lang="de-DE">KI-Server-Verbindung</title>

        <input-field type="url">
            <name>serverBUrl</name>
            <label>AI Server URL</label>
            <label lang="de-DE">KI-Server-URL</label>
            <placeholder>https://chat.voltimax.de</placeholder>
            <helpText>The base URL of the AI chat backend (Server B).</helpText>
            <helpText lang="de-DE">Die Basis-URL des KI-Chat-Backends (Server B).</helpText>
        </input-field>

        <input-field type="bool">
            <name>requireApiSecret</name>
            <label>Require API secret (data API)</label>
            <label lang="de-DE">API-Secret erforderlich (Daten-API)</label>
            <helpText>When enabled, Server B must present the Integration's secret access key (X-Voltimax-Api-Secret header) in addition to the access key. Enable only after Server B is configured with the secret.</helpText>
            <helpText lang="de-DE">Wenn aktiviert, muss Server B zusätzlich zum Access Key den Secret Access Key der Integration senden (X-Voltimax-Api-Secret-Header). Erst aktivieren, nachdem Server B mit dem Secret konfiguriert wurde.</helpText>
            <defaultValue>false</defaultValue>
        </input-field>

        <input-field type="password">
            <name>jwtSecret</name>
            <label>JWT Secret</label>
            <label lang="de-DE">JWT-Geheimnis</label>
            <helpText>Must match the JWT secret configured in the AI server's config.yaml.</helpText>
            <helpText lang="de-DE">Muss mit dem JWT-Geheimnis in der config.yaml des KI-Servers übereinstimmen.</helpText>
        </input-field>

        <input-field type="int">
            <name>jwtTtlMinutes</name>
            <label>JWT TTL (minutes)</label>
            <label lang="de-DE">JWT-Gültigkeit (Minuten)</label>
            <defaultValue>30</defaultValue>
        </input-field>
    </card>

    <!-- Card 3: Appearance & Colors -->
    <card>
        <title>Appearance</title>
        <title lang="de-DE">Erscheinungsbild</title>

        <input-field type="colorpicker">
            <name>primaryColor</name>
            <label>Primary color (brand surface)</label>
            <label lang="de-DE">Primärfarbe (Markenfläche)</label>
            <defaultValue>#D99A4E</defaultValue>
            <helpText>Brand color for the widget surface, launcher, and user messages.</helpText>
            <helpText lang="de-DE">Markenfarbe für die Widget-Fläche, den Launcher und Nutzernachrichten.</helpText>
        </input-field>

        <input-field type="colorpicker">
            <name>secondaryColor</name>
            <label>Secondary color (accents, optional)</label>
            <label lang="de-DE">Sekundärfarbe (Akzente, optional)</label>
            <defaultValue>#B87F3E</defaultValue>
            <helpText>Optional accent color. The current design uses the primary color as a single brand surface.</helpText>
            <helpText lang="de-DE">Optionale Akzentfarbe. Das aktuelle Design nutzt die Primärfarbe als einheitliche Markenfläche.</helpText>
        </input-field>

        <component name="sw-media-field">
            <name>logoMediaId</name>
            <label>Groot Avatar / Logo</label>
            <label lang="de-DE">Groot-Avatar / Logo</label>
            <helpText>Custom avatar image for the chat assistant. Shown on home screen and in messages.</helpText>
            <helpText lang="de-DE">Benutzerdefiniertes Avatar-Bild für den Chat-Assistenten. Wird auf der Startseite und in Nachrichten angezeigt.</helpText>
        </component>

        <input-field type="text">
            <name>widgetTitle</name>
            <label>Widget title</label>
            <label lang="de-DE">Widget-Titel</label>
            <defaultValue>GrootDesk Support</defaultValue>
        </input-field>

        <input-field type="textarea">
            <name>welcomeMessage</name>
            <label>Welcome message</label>
            <label lang="de-DE">Willkommensnachricht</label>
            <defaultValue>Hallo! Wie kann ich dir helfen?</defaultValue>
        </input-field>

        <input-field type="single-select">
            <name>themeMode</name>
            <label>Color mode</label>
            <label lang="de-DE">Farbmodus</label>
            <options>
                <option>
                    <id>light</id>
                    <name>Light</name>
                    <name lang="de-DE">Hell</name>
                </option>
                <option>
                    <id>dark</id>
                    <name>Dark</name>
                    <name lang="de-DE">Dunkel</name>
                </option>
                <option>
                    <id>auto</id>
                    <name>Auto (system preference)</name>
                    <name lang="de-DE">Automatisch (Systemeinstellung)</name>
                </option>
            </options>
            <defaultValue>light</defaultValue>
        </input-field>

        <input-field type="textarea">
            <name>customCss</name>
            <label>Custom CSS</label>
            <label lang="de-DE">Benutzerdefiniertes CSS</label>
            <helpText>Additional CSS rules applied to the chat widget.</helpText>
            <helpText lang="de-DE">Zusätzliche CSS-Regeln für das Chat-Widget.</helpText>
        </input-field>
    </card>

    <!-- Card 4: Privacy & Consent -->
    <card>
        <title>Privacy</title>
        <title lang="de-DE">Datenschutz</title>

        <input-field type="url">
            <name>privacyPolicyUrl</name>
            <label>Privacy policy URL</label>
            <label lang="de-DE">Datenschutzerklärung-URL</label>
            <placeholder>https://voltimax.de/datenschutz</placeholder>
        </input-field>

        <input-field type="url">
            <name>contactFormUrl</name>
            <label>Contact form URL (fallback)</label>
            <label lang="de-DE">Kontaktformular-URL (Fallback)</label>
            <placeholder>https://voltimax.de/kontakt</placeholder>
            <helpText>URL to redirect users when they request human support outside the chat.</helpText>
            <helpText lang="de-DE">URL zur Weiterleitung an den Support außerhalb des Chats.</helpText>
        </input-field>
    </card>

    <!-- Card 5: API Scope -->
    <card>
        <title>API Scope</title>
        <title lang="de-DE">API-Bereich</title>

        <input-field type="bool">
            <name>scopeOrders</name>
            <label>Orders</label>
            <label lang="de-DE">Bestellungen</label>
            <defaultValue>true</defaultValue>
        </input-field>

        <input-field type="bool">
            <name>scopeProducts</name>
            <label>Products</label>
            <label lang="de-DE">Produkte</label>
            <defaultValue>true</defaultValue>
        </input-field>

        <input-field type="bool">
            <name>scopeCustomers</name>
            <label>Customers</label>
            <label lang="de-DE">Kunden</label>
            <defaultValue>true</defaultValue>
        </input-field>

        <input-field type="bool">
            <name>scopeReturns</name>
            <label>Returns</label>
            <label lang="de-DE">Retouren</label>
            <defaultValue>true</defaultValue>
        </input-field>

        <input-field type="bool">
            <name>scopeCms</name>
            <label>CMS pages</label>
            <label lang="de-DE">CMS-Seiten</label>
            <defaultValue>true</defaultValue>
        </input-field>

        <input-field type="bool">
            <name>scopeB2bQuotes</name>
            <label>B2B quotes</label>
            <label lang="de-DE">B2B-Angebote</label>
            <defaultValue>false</defaultValue>
        </input-field>
    </card>

    <!-- Card 6: Rate Limiting -->
    <card>
        <title>Rate Limiting</title>
        <title lang="de-DE">Ratenbegrenzung</title>

        <input-field type="int">
            <name>rateLimitPerMinute</name>
            <label>Max requests per minute</label>
            <label lang="de-DE">Max. Anfragen pro Minute</label>
            <defaultValue>30</defaultValue>
        </input-field>

        <input-field type="int">
            <name>rateLimitVerifyPerMinute</name>
            <label>Max verification requests per minute</label>
            <label lang="de-DE">Max. Verifizierungsanfragen pro Minute</label>
            <defaultValue>5</defaultValue>
        </input-field>
    </card>

    <!-- Card 7: Development Mode -->
    <card>
        <title>Development Mode</title>
        <title lang="de-DE">Entwicklungsmodus</title>

        <input-field type="bool">
            <name>devModeEnabled</name>
            <label>Enable development mode</label>
            <label lang="de-DE">Entwicklungsmodus aktivieren</label>
            <defaultValue>false</defaultValue>
            <helpText>Widget only visible to users with the dev mode cookie. Share the activation URL to grant access.</helpText>
            <helpText lang="de-DE">Widget nur für Nutzer mit Dev-Mode-Cookie sichtbar. Teilen Sie die Aktivierungs-URL, um Zugriff zu gewähren.</helpText>
        </input-field>

        <input-field type="text">
            <name>devModeSecret</name>
            <label>Dev mode secret key</label>
            <label lang="de-DE">Dev-Mode-Schlüssel</label>
            <placeholder>my-secret-key-123</placeholder>
            <helpText>Activation URL: https://your-shop.de/?groot_dev=YOUR_SECRET_KEY — sets a 30-day cookie. Use ?groot_dev=off to deactivate.</helpText>
            <helpText lang="de-DE">Aktivierungs-URL: https://your-shop.de/?groot_dev=IHR_SCHLÜSSEL — setzt ein 30-Tage-Cookie. ?groot_dev=off zum Deaktivieren.</helpText>
        </input-field>
    </card>

</config>
