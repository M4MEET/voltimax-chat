{% sw_extends '@Storefront/storefront/page/checkout/finish/index.html.twig' %}

{% block page_checkout_finish %}
    {{ parent() }}

    {# Groot Chat Attribution — fire conversion event if purchase was influenced by chat recommendation #}
    {% if page.order is defined and page.order %}
    <script>
    (function(){
        try {
            var attrRaw = null;
            // Check cookie first, then sessionStorage
            var cookies = document.cookie.split(';');
            for (var i = 0; i < cookies.length; i++) {
                var c = cookies[i].trim();
                if (c.indexOf('groot_attribution=') === 0) {
                    attrRaw = decodeURIComponent(c.substring('groot_attribution='.length));
                    break;
                }
            }
            if (!attrRaw) {
                try { attrRaw = sessionStorage.getItem('groot_attribution'); } catch(e){}
            }
            if (!attrRaw) return;

            var attr = JSON.parse(attrRaw);
            // Only attribute if the click was within the last 30 minutes
            if (attr.ts && (Date.now() - attr.ts) > 86400000) return; // 24h attribution window

            var conversionData = {
                groot_ref: attr.ref || 'chat',
                groot_session: attr.session || attr.chat_id || '',
                groot_campaign: attr.campaign || '',
                product_page: attr.page || attr.product_name || '',
                order_number: {{ page.order.orderNumber|json_encode|raw }},
                order_total: {{ page.order.amountTotal|json_encode|raw }},
                currency: {{ (page.order.currency.isoCode ?? "EUR")|json_encode|raw }},
                items_count: {{ page.order.lineItems|length }}
            };

            // GA4 dataLayer event
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push(Object.assign({event: 'groot_conversion'}, conversionData));

            // POST to AI service dashboard for internal tracking.
            // Only send to the configured Server B; never fall back to a
            // hard-coded external host (would exfiltrate order data off-site).
            var grootServerUrl = {{ (config("VoltimaxChat.config.serverBUrl") ?? "")|json_encode|raw }};
            if (grootServerUrl) {
                try {
                    fetch(grootServerUrl + '/api/webhooks/conversion', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify(conversionData),
                        keepalive: true
                    });
                } catch(e) { /* silent — GA4 is the primary tracker */ }
            }

            // Clear attribution after firing (prevent double-counting)
            document.cookie = 'groot_attribution=;path=/;max-age=0';
            try { sessionStorage.removeItem('groot_attribution'); } catch(e){}
        } catch(e) { /* silent */ }
    })();
    </script>
    {% endif %}
{% endblock %}
