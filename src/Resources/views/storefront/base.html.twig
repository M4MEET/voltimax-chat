{% sw_extends '@Storefront/storefront/base.html.twig' %}

{% block base_body_script %}
    {{ parent() }}

    {% if config('VoltimaxChat.config.pluginEnabled') %}
        {# Development mode: cookie-based access control #}
        {% set devMode = config('VoltimaxChat.config.devModeEnabled') %}
        {% set devSecret = config('VoltimaxChat.config.devModeSecret') %}
        {% set showWidget = true %}

        {% if devMode and devSecret %}
            {% set showWidget = false %}

            {# Check URL param: ?groot_dev=SECRET sets cookie, ?groot_dev=off clears it #}
            {% set paramValue = app.request.query.get('groot_dev') %}
            {% if paramValue is same as(devSecret) %}
                {% set showWidget = true %}
                {# Cookie is set via inline script below #}
            {% elseif paramValue == 'off' %}
                {% set showWidget = false %}
                {# Cookie removal is handled via inline script below #}
            {% else %}
                {# Check existing cookie #}
                {% set cookieValue = app.request.cookies.get('groot_dev') %}
                {% if cookieValue == '1' %}
                    {% set showWidget = true %}
                {% endif %}
            {% endif %}
        {% endif %}

        {# Handle cookie set/remove via script #}
        {% set paramValue = app.request.query.get('groot_dev') %}
        {% if devMode and devSecret and paramValue is same as(devSecret) %}
            <script>document.cookie='groot_dev=1;path=/;max-age=2592000;SameSite=Lax';</script>
        {% elseif devMode and paramValue == 'off' %}
            <script>document.cookie='groot_dev=;path=/;max-age=0';</script>
        {% endif %}

        {% if showWidget %}
        <div id="voltimax-chat-root"
             data-voltimax-chat="true"
             data-voltimax-chat-options='{{ {
                 configUrl:  path('voltimax.chat.config'),
                 consentUrl: path('voltimax.chat.consent'),
                 verifyUrl:  path('voltimax.chat.verify')
             }|json_encode|raw }}'
             style="display: none;">
        </div>
        {% endif %}

        {# Groot Chat Attribution Tracking — detect groot_ref params and persist for purchase attribution #}
        <script>
        (function(){
            var params = new URLSearchParams(window.location.search);
            var ref = params.get('groot_ref');
            if (ref) {
                var attr = {
                    ref: ref,
                    session: params.get('groot_session') || '',
                    campaign: params.get('groot_campaign') || '',
                    page: window.location.pathname,
                    ts: Date.now()
                };
                document.cookie = 'groot_attribution=' + encodeURIComponent(JSON.stringify(attr)) + ';path=/;max-age=86400;SameSite=Lax';
                try { sessionStorage.setItem('groot_attribution', JSON.stringify(attr)); } catch(e){}
            }
        })();
        </script>
    {% endif %}
{% endblock %}
