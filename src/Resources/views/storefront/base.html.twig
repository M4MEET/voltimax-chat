{% sw_extends '@Storefront/storefront/base.html.twig' %}

{% block base_body_script %}
    {{ parent() }}

    {% if config('VoltimaxChat.config.pluginEnabled') %}
        {# Development mode: only show widget for allowed IPs #}
        {% set devMode = config('VoltimaxChat.config.devModeEnabled') %}
        {% set allowedIps = config('VoltimaxChat.config.devModeAllowedIps') %}
        {# Check multiple IP sources: Cloudflare header, X-Forwarded-For, and direct IP #}
        {% set clientIp = app.request.headers.get('CF-Connecting-IP') ?: (app.request.headers.get('X-Forwarded-For') ? app.request.headers.get('X-Forwarded-For')|split(',')|first|trim : app.request.clientIp) %}
        {% set showWidget = true %}

        {% if devMode and allowedIps %}
            {% set ipList = allowedIps|split(',') %}
            {% set showWidget = false %}
            {% for ip in ipList %}
                {% set trimmedIp = ip|trim %}
                {# Exact match #}
                {% if trimmedIp == clientIp %}
                    {% set showWidget = true %}
                {# IPv6 prefix match: if allowed IP contains ':', check if client IP starts with same /64 prefix #}
                {% elseif ':' in trimmedIp and ':' in clientIp %}
                    {% set allowedPrefix = trimmedIp|split(':')|slice(0, 4)|join(':') %}
                    {% set clientPrefix = clientIp|split(':')|slice(0, 4)|join(':') %}
                    {% if allowedPrefix == clientPrefix %}
                        {% set showWidget = true %}
                    {% endif %}
                {% endif %}
            {% endfor %}
        {% endif %}

        {% if showWidget %}
        <div id="voltimax-chat-root"
             data-voltimax-chat="true"
             data-voltimax-chat-options='{{ {
                 configUrl:  path('voltimax.chat.config'),
                 consentUrl: path('voltimax.chat.consent'),
                 verifyUrl:  path('voltimax.chat.verify')
             }|json_encode|raw }}'
             style="display: none;">
        </div>
        {% endif %}
    {% endif %}
{% endblock %}
